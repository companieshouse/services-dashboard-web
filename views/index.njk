{% extends "layout.njk" %}
{% set active = "teams" %}
{% from "macros.njk" import addDaysAgo, sonarLink, depTrackLink, DepTrackMetrics, setStandardId, addCoverageColorClass, addVulnerabilityKey %}

{% macro gitReleaseInfo(versionData, min, max) %}
    {% set ReleaseDate = versionData.lastBomImport %}

    <div title="{{ ReleaseDate }}">
        {% if versionData.uuid %}
            <a href="{{depTrackUri}}/projects/{{versionData.uuid}}/findings">
                {{ versionData.version }}
            </a>
            {{addDaysAgo( ReleaseDate ) }}
        {% else %}
            <a href="{{devGuideDocumentationLink}}">
                {{ versionData.version }}
            </a>
            {{addDaysAgo( ReleaseDate ) }}
        {% endif %}
    </div>
{% endmacro %}

{% macro addSonarColorClass(bugs, coverage, vulnerabilities) %}
   {% if coverage == 0 %}
      is-medium-vuln
   {% else %}
    {% if (bugs == 0) and (vulnerabilities == 0) and (coverage > 80) %}
        is-clear-vuln
    {% elseif (bugs < 10) and (vulnerabilities == 0) %}
        is-medium-vuln
    {% else %}
        is-critical-vuln
    {% endif %}
   {% endif %}
{% endmacro %}

{% macro addDepTrackColorClass(critical, high, medium, low) %}
   {% if critical != 0 %}
      is-critical-vuln
   {% elseif high != 0 %}
      is-high-vuln
   {% elseif medium != 0 %}
      is-medium-vuln
   {% elseif low != 0 %}
      is-low-vuln
   {% else %}
      is-clear-vuln
   {% endif %}
{% endmacro %}

{% macro buildServiceVersionCell(versionData) %}
    {% if versionData.version %}
        {% set metrics = versionData.metrics %}
        <td class="td-ecs {{ addDepTrackColorClass(metrics.critical, metrics.high, metrics.medium, metrics.low) }}">
            {{ gitReleaseInfo(
                versionData,
                thresholdsLive[0],
                thresholdsLive[1]
            ) }}
            {% if versionData.metrics %}
                <div class="level mt-1">
                    <span class="tag level-item tag is-critical-vuln has-tooltip has-tooltip-bottom" data-tooltip="Critical">
                        {{ versionData.metrics.critical }}
                    </span>
                    <span class="tag level-item is-high-vuln has-tooltip-bottom" data-tooltip="High">
                        {{ versionData.metrics.high }}
                    </span>
                    <span class="tag level-item is-medium-vuln has-tooltip-bottom" data-tooltip="Medium">
                        {{ versionData.metrics.medium }}
                    </span>
                    <span class="tag level-item is-low-vuln has-tooltip-bottom" data-tooltip="Low">
                        {{ versionData.metrics.low }}
                    </span>                    
                </div>
                {% if versionData.metrics.policyViolationsTotal > 0 %}
                <div class="level mt-1">
                    <span class="tag level-item is-high-vuln has-tooltip-bottom" data-tooltip="Policy Violations">
                        {% if versionData.uuid %}
                            <a href="{{depTrackUri}}/projects/{{versionData.uuid}}/policyViolations">
                                Policy Violations: {{ versionData.metrics.policyViolationsTotal }}
                            </a>
                        {% endif %}
                    </span>
                </div>
                {% endif %}
            {% else %}
                <span class="tag level-item is-warning has-tooltip-bottom" data-tooltip="SBOM for this version is missing from Dependency Track">
                    SBOM Missing
                </span>
            {% endif %}
        </td>
    {% else %}
        <td />
    {% endif %}
{% endmacro %}

{% block content %}
    <div class="field mb-4">
        <div class="control has-icons-left">
            <label for="table-search">
                Search 
                {# Just a default value, the actual number of services is 
                   calculated in the filter() function after initial render. #}
                <span id="service-count">{{ documents | length }}</span> 
                services:
            </label>
            <input
                id="table-search"
                class="input"
                type="text"
                placeholder="Search table..."
            >
        </div>
    </div>
    <div class="columns">
        <div class="column is-narrow">
            <!-- Master checkbox to control all .level1-checkbox -->
            <div class="masterCheckbox">
                <input type="checkbox" id="masterCheckbox-id" checked>
                <label for="masterCheckbox-id"><strong>Select All</strong></label>
                <hr>
            </div>

            <form id="filterForm">
            {% for document in documents %}
                {% if document %}
                {% set standardId = setStandardId(document._id) %}

                <div class="no-wrap-inline-contents">
                    <input type="checkbox" id="{{ standardId }}" class="level1-checkbox" checked>
                    <label for="{{ standardId }}" class="label-level1-checkbox">{{ document._id }} ({{ document.servicesCount }})</label>
                </div>
                {% endif %}
            {% endfor %}
            </form>
            <hr>
            {{addVulnerabilityKey("is-flex-direction-column", "mt-2")}}
        </div>

        <div class="column table-container">
            <table id="tab-table-id" class="table is-striped is-fullwidth is-hoverable is-bordered">
            <thead>
                <tr>
                <th class="row-header-title header-service is-narrow" id="col-head-service">Service</th>
                <th class="row-header-title header-git is-narrow" id="col-head-git-lang">Runtime</th>
                <th class="row-header-title header-ecs" id="col-head-ecs-latest-version">Latest Version</th>
                <th class="row-header-title header-ecs" id="col-head-ecs-cidev">CI Dev</th>
                <th class="row-header-title header-ecs" id="col-head-ecs-stag">Staging</th>
                <th class="row-header-title header-ecs" id="col-head-ecs-live">Live</th>
                <th class="row-header-title header-sonar-metric" id="col-head-sonar-coverage">Sonar</th>
                </tr>
            </thead>

            <tbody>
                {% for document in documents %}
                {% if document %}
                    {% for service in document.services %}
                    {% if service %}
                        {% set serviceOwner     = document._id %}
                        {% set serviceArea      = service.gitInfo.serviceArea %}
                        {% set depTrackCritical = service.latestVersion.metrics.critical %}
                        {% set depTrackHigh     = service.latestVersion.metrics.high %}
                        {% set depTrackMedium   = service.latestVersion.metrics.medium %}
                        {% set depTrackLow      = service.latestVersion.metrics.low %}
                        <tr class="transparent_row"
                            data-level1="{{ setStandardId(serviceOwner) }}"
                            data-level2="{{ service.name }}"
                            data-critical="{{ depTrackCritical }}"
                            data-high="{{ depTrackHigh }}"
                            data-medium="{{ depTrackMedium }}"
                            data-low="{{ depTrackLow }}"
                        >
                        <td class="td-name">
                            <a href="{{basePath}}/service/{{ service.name }}">{{ service.name }}</a>
                            <div class="is-flex is-align-items-baseline tags">
                                <span class="tag">{{ serviceOwner }}</span>
                                {% if serviceArea %}
                                    <span class="tag">{{ serviceArea }}</span>
                                {% endif %}
                            </div>
                        </td>
                        
                        <td class="td-runtime">
                            {% set lang = service.latestVersion.lang %}
                            <div id="runtime-tags" class="is-flex-direction-column">
                                {% for info in service.latestVersion.runtime.runtime %}
                                    {% if info %}
                                        {% if info.color == "red" %}
                                            <span class="tag is-critical-vuln">
                                                {% if lang === 'go' %}
                                                    {{lang}} - 
                                                {% endif %}
                                                {{ info.value }}
                                            </span>
                                        {% elseif info.color == "green" %}
                                            <span class="tag is-clear-vuln">
                                                {% if lang === 'go' %}
                                                    {{lang}} - 
                                                {% endif %}
                                                {{ info.value }}
                                            </span>
                                        {% elseif info.color == "yellow" %}
                                            <span class="tag is-medium-vuln">
                                                {% if lang === 'go' %}
                                                    {{lang}} - 
                                                {% endif %}
                                                {{ info.value }}
                                            </span>
                                        {% elseif info.color == "grey" %}
                                            <span class="tag is-low-vuln">
                                                {% if lang === 'go' %}
                                                    {{lang}} - 
                                                {% endif %}
                                                {{ info.value }}
                                            </span>
                                        {% endif %}
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </td>

                        <!-- Latest Version -->
                        {{ buildServiceVersionCell(service.latestVersion) }}

                        <!-- CI DEV -->
                        {{ buildServiceVersionCell(service.ecs.cidev) }}

                        <!-- STAGING -->
                        {{ buildServiceVersionCell(service.ecs.staging) }}

                        <!-- LIVE -->
                        {{ buildServiceVersionCell(service.ecs.live) }}

                        <!-- SONAR -->
                        {% if service.sonarMetrics.overall | isEmpty %}
                            <td>
                                Sonar not configured
                            </td>
                        {% else %}
                            {% set sonarBugs = service.sonarMetrics.overall.bugs %}
                            {% set coverage = service.sonarMetrics.overall.coverage %}
                            {% set vulnerabilities = service.sonarMetrics.overall.vulnerabilities %}
                            {% set code_smells = service.sonarMetrics.overall.code_smells %}
                            <td class="td-sonar-metrics {{ addSonarColorClass(sonarBugs, coverage, vulnerabilities) }}">
                                {% if coverage == 0 %}
                                    <progress class="progress" value="0" max="100" data-tooltip="Unknown Coverage">
                                        0
                                    </progress>
                                {% else %}
                                    <progress class="progress {{ addCoverageColorClass(coverage) }} has-tooltip" value="{{coverage}}" max="100" data-tooltip="{{ coverage }}% Overall Coverage">
                                        {{ coverage }}
                                    </progress>
                                {% endif %}
                                <div class="level">
                                    <span class="tag level-item is-critical-vuln has-tooltip-bottom" data-tooltip="Vulnerabilities">
                                        {{ vulnerabilities }}
                                    </span>
                                    <span class="tag level-item is-medium-vuln has-tooltip-bottom" data-tooltip="Bugs">
                                        {{ sonarBugs }}
                                    </span>
                                    <span class="tag level-item is-low-vuln has-tooltip-bottom" data-tooltip="Code Smells">
                                        {{ code_smells }}
                                    </span>
                                </div>
                            </td>
                        {% endif%}
                        </tr>
                    {% endif %}
                    {% endfor %}
                {% endif %}
                {% endfor %}
            </tbody>
            </table>
        </div>
    </div>

<script>
document.addEventListener("DOMContentLoaded", () => {
  const master = document.getElementById("masterCheckbox-id");
  const checkboxes = [...document.querySelectorAll(".level1-checkbox")];
  const rows = [...document.querySelectorAll("#tab-table-id tbody tr")];
  const searchInput = document.getElementById("table-search");
  const serviceCount = document.getElementById("service-count");

  // Sort state: remembers last sorted column + direction
  const sortState = {
    column: null,
    dir: "desc" // first click sorts highest critical count first
  };

  // Header -> column index in the table
  const sortableHeaders = [
    { id: "col-head-ecs-latest-version", colIndex: 2 },
    { id: "col-head-ecs-cidev",          colIndex: 3 },
    { id: "col-head-ecs-stag",           colIndex: 4 },
    { id: "col-head-ecs-live",           colIndex: 5 }
  ];

    function initializeSortIndicators() {
        sortableHeaders.forEach(({ id }) => {
            const header = document.getElementById(id);
            if (!header) return;

            header.setAttribute("aria-sort", "none");

            const label = header.textContent.trim();
            header.innerHTML = `${label} <span class="sort-indicator" aria-hidden="true">⇅</span>`;
        });
    }

    function updateSortIndicators() {
        sortableHeaders.forEach(({ id, colIndex }) => {
            const header = document.getElementById(id);
            if (!header) return;

            const indicator = header.querySelector(".sort-indicator");
            const isActive = sortState.column === colIndex;

            if (!indicator) return;

            if (!isActive) {
                indicator.textContent = "⇅";
                indicator.style.opacity = "1";
                header.setAttribute("aria-sort", "none");
                return;
            }

            indicator.textContent = sortState.dir === "desc" ? "↓" : "↑";
            indicator.style.opacity = "1";
            header.setAttribute("aria-sort", sortState.dir === "desc" ? "descending" : "ascending");
        });
    }

  // Reads critical count from a version cell.
  // Uses the first "critical" tag in that cell; if missing, treat as -1.
  function getCriticalFromCell(cell) {
    const criticalTag = cell?.querySelector(".level .tag.is-critical-vuln");
    const value = Number.parseInt(criticalTag?.textContent?.trim() || "", 10);
    return Number.isFinite(value) ? value : -1;
  }

  function sortRowsByColumn(colIndex) {
    const tbody = document.querySelector("#tab-table-id tbody");

    // Toggle direction if user clicks same column; otherwise default desc
    if (sortState.column === colIndex) {
      sortState.dir = sortState.dir === "desc" ? "asc" : "desc";
    } else {
      sortState.column = colIndex;
      sortState.dir = "desc";
    }

    const direction = sortState.dir === "desc" ? -1 : 1;

    rows.sort((a, b) => {
      const aVal = getCriticalFromCell(a.cells[colIndex]);
      const bVal = getCriticalFromCell(b.cells[colIndex]);

      if (aVal !== bVal) {
        return (aVal - bVal) * direction;
      }

      // Tie-breaker for stable UX: by service name
      const aName = (a.dataset.level2 || "").toLowerCase();
      const bName = (b.dataset.level2 || "").toLowerCase();
      return aName.localeCompare(bName);
    });

    tbody.append(...rows);
        updateSortIndicators();

    // Reapply existing filters/search and refresh service count
    filter();
  }

  // Apply filters based on selected teams and search term
  function filter() {
    const activeTeams = new Set(checkboxes.filter(cb => cb.checked).map(cb => cb.id));

    if (checkboxes) {
      master.checked = checkboxes.length === activeTeams.size;
    }

    // No checkboxes are selected
    if (activeTeams.size === 0) {
      master.checked = false;
    }

    const searchTerm = searchInput.value.toLowerCase().trim();

    rows.forEach(row => {
      const matchesTeam = activeTeams.has(row.dataset.level1);
      const matchesSearch = row.innerText.toLowerCase().includes(searchTerm);
      row.style.display = (matchesTeam && matchesSearch) ? "" : "none";
    });

    // Update service count
    const visibleCount = rows.filter(row => row.style.display !== "none").length;
    serviceCount.textContent = visibleCount;
  }

  // Master checkbox toggles all
  master.addEventListener("change", () => {
    checkboxes.forEach(cb => cb.checked = master.checked);
    filter();
  });

  // Individual team filters
  checkboxes.forEach(cb => cb.addEventListener("change", filter));

  // Search input filter (real-time)
  searchInput.addEventListener("input", filter);

    initializeSortIndicators();
    updateSortIndicators();

  // Click-to-sort bindings for env/version headers
  sortableHeaders.forEach(({ id, colIndex }) => {
    const header = document.getElementById(id);
    if (!header) return;

    header.style.cursor = "pointer";
    header.title = "Sort by critical vulnerabilities";

    header.addEventListener("click", () => {
      sortRowsByColumn(colIndex);
    });
  });

  filter(); // initial render
});
</script>

{% endblock %}
