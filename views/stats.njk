{% extends "layout.njk" %}
{% set active = "stats" %}

{% block content %}
<h2 class="title">Statistics</h2>
<div class="columns is-multiline">
  <div class="column is-full">
    <div class="box">
      <h3 class="subtitle">Vulnerabilities per Team</h3>
        <canvas id="chart-team-vulnerabilities" aria-label="Vulnerabilities per Team" role="img">
            <p>Vulnerabilities per Team</p>
        </canvas>
    </div>
  </div>
  <div class="column is-full">
    <div class="box">
      <h3 class="subtitle">Vulnerabilities per Service Area</h3>
        <canvas id="chart-service-area-vulnerabilities" aria-label="Vulnerabilities per Service Area" role="img">
            <p>Vulnerabilities per Service Area</p>
        </canvas>
    </div>
  </div>
  <div class="column is-full">
    <div class="box">
      <h3 class="subtitle">Services per Team</h3>
        <canvas id="chart-services-per-team" aria-label="Services per Team" role="img">
            <p>Services per Team</p>
        </canvas>
    </div>
  </div>
</div>
{% endblock %}

{% block scripts %}
<script src="{{ basePath }}/js/libs/chartjs/4.5.1/chart.umd.min.js"></script>
<script>
    const stats = {{ stats | safe }}; // safe because it is coming from Mongo, not user input
    const isDarkMode = window.matchMedia("(prefers-color-scheme: dark)").matches;
    const textColor = isDarkMode ? "#FFF" : "#000";
    const gridColor = isDarkMode ? "#444" : "#e0e0e0";
    const criticalColor = "#d21919";
    const highColor = "#f9a805";
    const mediumColor = "#f9e10b";
    const lowColor = "#6b6b6b";
    const policyViolationsColor = "#1557d1";
    const chartOptions = {
        scales: {
            y: { beginAtZero: true, ticks: { color: textColor }, grid: { color: gridColor } },
            x: { ticks: { color: textColor }, grid: { color: gridColor } }
        },
        plugins: {
            legend: { labels: { color: textColor } }
        }
    };
    const averageNumberOfServices = stats.reduce((acc, t) => acc + t.servicesCount, 0) / stats.length;
    new Chart(document.getElementById("chart-services-per-team"), {
        type: "bar",
        data: {
          labels: stats.map(t => t._id),
          datasets: [
            { label: "Average Number of Services (all teams)", data: stats.map(t => averageNumberOfServices), type: "line", backgroundColor: highColor, borderColor: highColor, borderWidth: 2, fill: false },
            { label: "Number of Services", data: stats.map(t => t.servicesCount), type: "bar", backgroundColor: "#1E521E", borderColor: "#1E521E", borderWidth: 1 }
          ]
        },
        options: chartOptions
    });
    new Chart(document.getElementById("chart-team-vulnerabilities"), {
        type: "line",
        data: {
        labels: stats.map(s => s._id),
        datasets: [
            { label: "Critical",          data: stats.map(s => s.totalCritical),              backgroundColor: criticalColor, borderColor: criticalColor,  tension: 0.1 },
            { label: "High",              data: stats.map(s => s.totalHigh),                  backgroundColor: highColor, borderColor: highColor,  tension: 0.1 },
            { label: "Medium",            data: stats.map(s => s.totalMedium),                backgroundColor: mediumColor, borderColor: mediumColor,  tension: 0.1 },
            { label: "Low",               data: stats.map(s => s.totalLow),                   backgroundColor: lowColor, borderColor: lowColor, tension: 0.1 },
            { label: "Policy Violations", data: stats.map(s => s.totalPolicyViolationsTotal), backgroundColor: policyViolationsColor, borderColor: policyViolationsColor, tension: 0.1 },
        ]
        },
        options: chartOptions
    });
    const serviceAreaMap = {};
    stats.forEach(team => {
        (team.services || []).forEach(service => {
            const area = service.serviceArea || "No-Service-Area";
            if (!serviceAreaMap[area]) {
                serviceAreaMap[area] = { critical: 0, high: 0, medium: 0, low: 0, policyViolationsTotal: 0 };
            }
            serviceAreaMap[area].critical              += service.critical              || 0;
            serviceAreaMap[area].high                  += service.high                  || 0;
            serviceAreaMap[area].medium                += service.medium                || 0;
            serviceAreaMap[area].low                   += service.low                   || 0;
            serviceAreaMap[area].policyViolationsTotal += service.policyViolationsTotal || 0;
        });
    });
    const serviceAreaLabels = Object.keys(serviceAreaMap).sort();
    const serviceAreaStats  = serviceAreaLabels.map(k => serviceAreaMap[k]);

    new Chart(document.getElementById("chart-service-area-vulnerabilities"), {
        type: "line",
        data: {
          labels: serviceAreaLabels,
          datasets: [
              { label: "Critical",          data: serviceAreaStats.map(s => s.critical),              backgroundColor: criticalColor, borderColor: criticalColor,  tension: 0.1 },
              { label: "High",              data: serviceAreaStats.map(s => s.high),                  backgroundColor: highColor, borderColor: highColor,  tension: 0.1 },
              { label: "Medium",            data: serviceAreaStats.map(s => s.medium),                backgroundColor: mediumColor, borderColor: mediumColor,  tension: 0.1 },
              { label: "Low",               data: serviceAreaStats.map(s => s.low),                   backgroundColor: lowColor, borderColor: lowColor, tension: 0.1 },
              { label: "Policy Violations", data: serviceAreaStats.map(s => s.policyViolationsTotal), backgroundColor: policyViolationsColor, borderColor: policyViolationsColor, tension: 0.1 },
          ]
        },
        options: chartOptions
    });
</script>

{% endblock %}