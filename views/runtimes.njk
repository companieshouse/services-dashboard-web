{% extends "layout.njk" %}
{% set active = "runtimes" %}

{% from "macros.njk" import addDaysAgo %}

{% block content %}

<nav aria-label="Runtimes sections">
  <h2 class="title is-2">Our Runtimes</h2>
  <ul aria-label="Jump to runtime sections">
    {% for project, projArray in endols %}
      <li><a href="#{{ project }}" aria-label="View {{project}} runtime information">{{ project }}</a></li>
    {% endfor %}
  </ul>
</nav>

<br>

{% for project, projArray in endols %}
  <h2 class="title is-3" id="{{ project }}">{{ project }}</h2>
  <p>End of life (EOL) information for {{ project }} runtimes. Further information can be found on the <a href="{{ eolUri }}/{{ project }}">'{{ project }}' end of life page</a>.</p>

  <div class="table-container">
    <table class="table is-fullwidth">
      <thead>
        <!-- Col Headers -->
        <tr>
            <th class="row-header-title header-cycle"           id="col-head-cycle"           data-type="string">Version</th>
            <th class="row-header-title header-eol"             id="col-head-eol"             data-type="date">End of Life Date</th>
            <th class="row-header-title header-latest"          id="col-head-latest"          data-type="string">Latest Version</th>
            <th class="row-header-title header-latest-rel-date" id="col-head-latest-rel-date" data-type="date">Latest Release Date</th>
        </tr>
      </thead>
      <tbody>
        {% for cycle in projArray %}
            {% set oneYearLater = now + (365 * 24 * 60 * 60 * 1000) %}
            {% if not cycle.eolTs %}
              {% set eolClass = "" %}
            {% else %}
              {% if cycle.eolTs < now %}
                {% set eolClass = "has-background-danger-light has-text-black" %}
              {% elif cycle.eolTs <= oneYearLater %}
                {% set eolClass = "has-background-warning-light has-text-black" %}
              {% else %}
                {% set eolClass = "has-background-success-light has-text-black" %}
              {% endif %}
            {% endif %}

            <tr data-level1="{{ project }}" data-level2="{{ cycle.cycle }}">
              <td class="td-cycle">
                {{ cycle.cycle }}
                {% if cycle.lts == 'true' %}
                  <span>(LTS)</span>
                {% endif %}
              </td>
              <td class="td-eol {{eolClass}}">
                {% if cycle.eol %}
                  <span>{{ cycle.eol }}</span>{{ addDaysAgo(cycle.eol) }}
                {% else %}
                  <span>Unknown</span>
                {% endif %}
              </td>
              <td class="td-latest">{{ cycle.latest }}</td>
              <td class="td-latest-rel-date">
                <span>{{ cycle.latestReleaseDate }}</span>{{ addDaysAgo(cycle.latestReleaseDate) }}
              </td>
            </tr>
        {% endfor %}
      </tbody>
    </table>
  </div>
{% endfor %}
{% endblock %}